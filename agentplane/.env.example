# ── AgentPlane environment (copy to .env) ─────────────────────────────────────

# Postgres (matches docker-compose.yml — host port 5433 to avoid clashing with a system pg)
DATABASE_URL=postgres://agentplane:agentplane@localhost:5433/agentplane

# Redis (BullMQ + pub/sub control + events — host port 6380)
REDIS_URL=redis://localhost:6380

# Data root — projects (bare mirrors), workspaces (worktrees), uploads, logs, artifacts.
# In production this defaults to /srv/agentplane; for local dev point it inside the repo.
AGENTPLANE_DATA_DIR=./.data

# API
API_PORT=4000
# 32+ byte secret used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string
# Cookie over plain http for local dev; set true behind TLS in prod
COOKIE_SECURE=false

# Single-user seed (Phase 1). Created by `pnpm db:seed`.
SEED_USER_EMAIL=admin@agentplane.local
SEED_USER_PASSWORD=changeme

# Worker
WORKER_CONCURRENCY=2

# Portal → API base (browser-visible)
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
