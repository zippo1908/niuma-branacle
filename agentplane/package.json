{
  "name": "agentplane",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, demand-driven control plane for AI coding agents",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @agentplane/db generate",
    "db:migrate": "pnpm --filter @agentplane/db migrate",
    "db:seed": "pnpm --filter @agentplane/db seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "@types/node": "^20.16.11"
  }
}
